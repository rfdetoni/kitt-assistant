{
  "schema_version": 1,
  "sections": [
    {
      "id": "assistant.core",
      "component": "kitt-assistant",
      "title": "Assistant / Daemon",
      "description": "Runtime headless e conexão com provedores.",
      "version": 1,
      "fields": [
        {
          "key": "listen",
          "label": "IPC Listen",
          "type": "string",
          "default": "127.0.0.1:41827",
          "description": "Somente loopback é permitido.",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "base_url",
          "label": "Legacy provider base URL",
          "type": "url",
          "default": "http://127.0.0.1:11434/v1",
          "description": "Bootstrap legado usado ao criar models.json pela primeira vez.",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "model",
          "label": "Legacy model",
          "type": "string",
          "default": "",
          "placeholder": "Selecione/configure explicitamente",
          "description": "Bootstrap legado usado ao criar models.json pela primeira vez.",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "api_key_env",
          "label": "Legacy API key env",
          "type": "secret_ref",
          "default": "",
          "sensitive": true,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "local_provider",
          "label": "Legacy provider is local",
          "type": "boolean",
          "default": true,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "allow_personal_remote",
          "label": "Permitir memória pessoal em modelo remoto",
          "type": "boolean",
          "default": false,
          "description": "Mantém desligado por padrão para evitar egress de dados pessoais.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "hud_ttl_ms",
          "label": "HUD TTL (ms)",
          "type": "integer",
          "default": 8000,
          "minimum": 500,
          "maximum": 120000,
          "apply_mode": "live"
        }
      ]
    },
    {
      "id": "assistant.models",
      "component": "kitt-assistant",
      "title": "Models / Routing",
      "description": "Perfis fast/heavy e roteamento OpenAI-compatible.",
      "version": 1,
      "fields": [
        {
          "key": "fast.base_url",
          "label": "Fast base URL",
          "type": "url",
          "default": "http://127.0.0.1:11434/v1",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "fast.model",
          "label": "Fast model",
          "type": "string",
          "default": "",
          "placeholder": "Listar modelos do provider",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "fast.local_provider",
          "label": "Fast local",
          "type": "boolean",
          "default": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "fast.api_key_env",
          "label": "Fast API key env",
          "type": "secret_ref",
          "default": "",
          "sensitive": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "heavy.base_url",
          "label": "Heavy base URL",
          "type": "url",
          "default": "http://127.0.0.1:11434/v1",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "heavy.model",
          "label": "Heavy model",
          "type": "string",
          "default": "",
          "placeholder": "Listar modelos do provider",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "heavy.local_provider",
          "label": "Heavy local",
          "type": "boolean",
          "default": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "speech_to_text.model",
          "label": "STT model",
          "type": "string",
          "default": "",
          "description": "Opcional para o Worker local; obrigatório apenas quando o provider remoto exigir um model id.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "speech_to_text.allow_remote",
          "label": "Permitir STT remoto",
          "type": "boolean",
          "default": false,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "fast_max_chars",
          "label": "Fast max chars",
          "type": "integer",
          "default": 360,
          "minimum": 32,
          "maximum": 10000,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "fast_max_lines",
          "label": "Fast max lines",
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 200,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "heavy.api_key_env",
          "label": "Heavy API key env",
          "type": "secret_ref",
          "default": "",
          "sensitive": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "speech_to_text.base_url",
          "label": "STT base URL",
          "type": "url",
          "default": "http://127.0.0.1:8000/v1",
          "description": "Servidor STT local OpenAI-compatible. O worker KITT usa 127.0.0.1:8000 por padrão.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "speech_to_text.api_key_env",
          "label": "STT API key env",
          "type": "secret_ref",
          "default": "",
          "sensitive": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "speech_to_text.local_provider",
          "label": "STT local",
          "type": "boolean",
          "default": true,
          "apply_mode": "daemon_restart"
        }
      ]
    },
    {
      "id": "assistant.voice",
      "component": "kitt-assistant",
      "title": "Voice / Wake word",
      "description": "Hands-free, VAD, wake word, STT e TTS.",
      "version": 1,
      "fields": [
        {
          "key": "enabled",
          "label": "Voice enabled",
          "type": "boolean",
          "default": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "locale",
          "label": "Locale",
          "type": "string",
          "default": "pt-BR",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "activation_mode",
          "label": "Activation mode",
          "type": "enum",
          "default": "auto",
          "options": [
            "auto",
            "wakeword",
            "transcript_prefix"
          ],
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wakeword_model_path",
          "label": "Wake word model",
          "type": "path",
          "default": "wakewords/kitt.rpw",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "min_rms",
          "label": "Minimum RMS",
          "type": "number",
          "default": 0.008,
          "minimum": 0.0001,
          "maximum": 0.5,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "noise_multiplier",
          "label": "Noise multiplier",
          "type": "number",
          "default": 2.2,
          "minimum": 1.1,
          "maximum": 20,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "silence_ms",
          "label": "Silence (ms)",
          "type": "integer",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "max_utterance_ms",
          "label": "Max utterance (ms)",
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 120000,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_enabled",
          "label": "TTS enabled",
          "type": "boolean",
          "default": true,
          "apply_mode": "live"
        },
        {
          "key": "wake_phrases",
          "label": "Wake phrases",
          "type": "string_list",
          "default": [
            "kitt",
            "ei kitt",
            "hey kitt",
            "olá kitt"
          ],
          "description": "Lista de prefixos aceitos no fallback por transcrição.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_fuzzy_enabled",
          "label": "Detecção fonética de KITT",
          "type": "boolean",
          "default": true,
          "description": "Aceita pequenas variações de transcrição de KITT sem usar aliases genéricos perigosos.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_fuzzy_max_distance",
          "label": "Tolerância fonética",
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_cooldown_ms",
          "label": "Wake cooldown (ms)",
          "type": "integer",
          "default": 1200,
          "minimum": 0,
          "maximum": 10000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "speech_start_ms",
          "label": "Confirmação de fala (ms)",
          "type": "integer",
          "default": 80,
          "minimum": 20,
          "maximum": 500,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "vad_release_ratio",
          "label": "VAD release ratio",
          "type": "number",
          "default": 0.65,
          "minimum": 0.3,
          "maximum": 1.0,
          "advanced": true,
          "description": "Histerese para não cortar sílabas mais baixas após o início da fala.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "pre_roll_ms",
          "label": "Pre-roll (ms)",
          "type": "integer",
          "default": 350,
          "minimum": 0,
          "maximum": 5000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "min_speech_ms",
          "label": "Minimum speech (ms)",
          "type": "integer",
          "default": 180,
          "minimum": 1,
          "maximum": 10000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "command_timeout_ms",
          "label": "Command timeout (ms)",
          "type": "integer",
          "default": 8000,
          "minimum": 100,
          "maximum": 120000,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_autostart",
          "label": "Auto-start local STT worker",
          "type": "boolean",
          "default": true,
          "description": "Quando o STT local não está disponível, tenta iniciar kitt-stt/kitt_workers automaticamente.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_worker_model",
          "label": "Local STT worker model",
          "type": "string",
          "default": "",
          "placeholder": "Modelo/path explícito ou KITT_WHISPER_MODEL",
          "description": "Sem fallback hardcoded. Configure o modelo/path que o faster-whisper deve carregar.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_start_timeout_ms",
          "label": "STT startup timeout (ms)",
          "type": "integer",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_voice_name",
          "label": "Voz TTS instalada",
          "type": "string",
          "default": "",
          "placeholder": "Opcional: nome exato de uma voz instalada",
          "description": "Sem nome hardcoded. Se vazio, usa seleção do SO e preferência masculina quando suportada.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_prefer_male",
          "label": "Preferir voz masculina",
          "type": "boolean",
          "default": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_rate",
          "label": "Ritmo TTS",
          "type": "integer",
          "default": -1,
          "minimum": -10,
          "maximum": 10,
          "description": "Negativo = mais calmo; positivo = mais rápido.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_pitch",
          "label": "Pitch TTS",
          "type": "integer",
          "default": -2,
          "minimum": -10,
          "maximum": 10,
          "description": "Aplicado nos backends que suportam pitch.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_volume",
          "label": "Volume TTS",
          "type": "integer",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "echo_guard_ms",
          "label": "Echo guard (ms)",
          "type": "integer",
          "default": 350,
          "minimum": 0,
          "maximum": 10000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "allow_transcript_prefix_fallback",
          "label": "Permitir fallback por transcrição",
          "type": "boolean",
          "default": false,
          "description": "Se ativo no modo auto e sem modelo .rpw, transcreve áudio continuamente.",
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_threshold",
          "label": "Wakeword Threshold",
          "type": "number",
          "default": 0.5,
          "minimum": 0.01,
          "maximum": 1.0,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_avg_threshold",
          "label": "Wakeword Avg Threshold",
          "type": "number",
          "default": 0.2,
          "minimum": 0.01,
          "maximum": 1.0,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_min_scores",
          "label": "Wakeword Min Scores",
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_eager",
          "label": "Wakeword Eager Mode",
          "type": "boolean",
          "default": false,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_vad_mode",
          "label": "Wakeword VAD Mode",
          "type": "enum",
          "default": "off",
          "options": [
            "off",
            "easy",
            "medium",
            "hard"
          ],
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "wake_gain_normalizer",
          "label": "Wakeword Gain Normalizer",
          "type": "boolean",
          "default": false,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_connect_timeout_ms",
          "label": "STT Connect Timeout (ms)",
          "type": "integer",
          "default": 1000,
          "minimum": 100,
          "maximum": 30000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_request_timeout_ms",
          "label": "STT Request Timeout (ms)",
          "type": "integer",
          "default": 15000,
          "minimum": 1000,
          "maximum": 120000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_warm_strategy",
          "label": "STT Warmup Strategy",
          "type": "enum",
          "default": "on_wake",
          "options": [
            "on_wake",
            "startup",
            "lazy"
          ],
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_device",
          "label": "STT Device",
          "type": "string",
          "default": "auto",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_compute_type",
          "label": "STT Compute Type",
          "type": "string",
          "default": "default",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_num_workers",
          "label": "STT Worker Threads",
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 16,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_beam_size",
          "label": "STT Beam Size",
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "stt_vad_filter",
          "label": "STT VAD Filter (Silero)",
          "type": "boolean",
          "default": true,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "voice_llm_timeout_ms",
          "label": "Voice LLM Timeout (ms)",
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_backend",
          "label": "TTS Backend",
          "type": "enum",
          "default": "system",
          "options": [
            "system",
            "piper"
          ],
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_timeout_ms",
          "label": "TTS Timeout (ms)",
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_piper_base_url",
          "label": "Piper TTS Base URL",
          "type": "url",
          "default": "http://127.0.0.1:5000",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_piper_voice",
          "label": "Piper Voice Model",
          "type": "string",
          "default": "",
          "advanced": true,
          "apply_mode": "daemon_restart"
        },
        {
          "key": "tts_fallback_to_system",
          "label": "Fallback Piper para TTS do SO",
          "type": "boolean",
          "default": true,
          "advanced": true,
          "apply_mode": "daemon_restart"
        }
      ]
    },
